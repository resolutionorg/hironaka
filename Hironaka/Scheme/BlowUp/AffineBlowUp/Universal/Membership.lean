module

public import Hironaka.Scheme.BlowUp.AffineBlowUp.Exceptional
import Hironaka.Scheme.BlowUp.Cancellation
import Hironaka.Scheme.BlowUp.InverseImage
import Hironaka.Scheme.IdealSheaf.StalkIdeal

/-!
# The chart membership criterion

A point `x` of the affine blow-up `B = affineBlowUp I` lies in the chart of `a ∈ I` iff the image
of `a` in `𝒪_{B,x}` generates the stalk of the exceptional ideal `I·𝒪_B` at `x`
[Sta, Tag 0BFL]. The printed proof invokes the universal property; the proof here proceeds from
the chart overlaps and cancellation instead, so that the universal property
(`Hironaka.Scheme.BlowUp.AffineBlowUp.Universal.Kernel`, `Uniqueness`) can use the criterion.

The argument.  Every `x` is `chart b x'` for some `b ∈ I` and a point `x'` of `Spec R[I/b]`.  The
open immersion `j = chart b` identifies the stalks, so everything is computed in
`𝒪_{Spec R[I/b], x'}`, a localization of `R[I/b]` at the prime `x'`:

* the stalk of the exceptional ideal at `x` corresponds to the stalk of
  `(exceptionalIdeal I).comap j = ofIdealTop (b)` (`affineBlowUp.comap_exceptionalIdeal_chart`),
  generated by the germ of `b`, a nonzerodivisor (nonzerodivisors of `R[I/b]` stay nonzerodivisors
  in its localizations);
* the image of `a` corresponds to the germ of `a ∈ R[I/b]`, and `a = b · (a/b)` there
  (`algebraMap_eq_mul_ratio`);
* `x = j x'` lies in the chart of `a` iff `x' ∈ D(a/b)` (`affineBlowUp.chart_preimage_chart`) iff
  the germ of `a/b` is a unit (`Scheme.mem_basicOpen_top`, `basicOpen_eq_of_affine`).

Hence `(a) = (b)` at `x` iff `a/b` is a unit at `x`: if `a/b` is a unit, `(b · (a/b)) = (b)`; if
`(b · (a/b)) = (b)` with `b` a nonzerodivisor, `a/b` is a unit (cancellation,
`isUnit_of_span_mul_eq_span`).  The chart overlaps `U_a ∩ U_b = D(a/b)` are the gluing data of
[Hau14, Definition 4.13]; the description of the stalks of the blow-up as localizations of the
chart rings is the local blow-up of [Hau14, Definitions 4.15 and 4.16].  The transport lemmas of
the first section are bookkeeping for affine schemes.
-/

@[expose] public section

namespace AlgebraicGeometry

open AlgebraicGeometry CategoryTheory Scheme.IdealSheafData TopologicalSpace

universe u

section Spec

variable {X : Scheme.{u}}

/-- On an affine scheme, the ideal of `ofIdealTop J` on the affine open `⊤` is `J`. -/
theorem ofIdealTop_ideal_top [IsAffine X] (J : Ideal Γ(X, ⊤)) :
    (Scheme.IdealSheafData.ofIdealTop J).ideal ⟨⊤, isAffineOpen_top X⟩ = J := by
  rw [Scheme.IdealSheafData.ofIdealTop_ideal, show homOfLE (le_top :
      (⊤ : X.Opens) ≤ ⊤) = 𝟙 _ from rfl, op_id,
    CategoryTheory.Functor.map_id, CommRingCat.hom_id, Ideal.map_id]

/-- On an affine scheme, the stalk of `ofIdealTop J` at `x` is generated by the germs of `J`. -/
theorem stalkIdeal_ofIdealTop [IsAffine X] (J : Ideal Γ(X, ⊤)) (x : X) :
    (Scheme.IdealSheafData.ofIdealTop J).stalkIdeal x = J.map (X.presheaf.germ ⊤ x
        (Opens.mem_top x)).hom := by
  rw [Scheme.IdealSheafData.stalkIdeal_eq_map_germ _ ⟨⊤, isAffineOpen_top X⟩ (Opens.mem_top x),
      ofIdealTop_ideal_top]

/-- On an affine scheme, the ideal sheaf of a principal ideal generated by a nonzerodivisor of the
global sections is invertible (the definition of `IsInvertible` with the affine open `⊤`). -/
theorem isInvertible_ofIdealTop_span_singleton [IsAffine X] {g : Γ(X, ⊤)}
    (hg : g ∈ nonZeroDivisors Γ(X, ⊤)) : (Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {g})).IsInvertible := fun x =>
  ⟨⟨⊤, isAffineOpen_top X⟩, Opens.mem_top x, g, hg, ofIdealTop_ideal_top _⟩

variable {S : CommRingCat.{u}}

/-- The germ at a point `x` of `Spec S` of an element `s ∈ S`, read as a global section through
`ΓSpecIso`: the canonical map `S → 𝒪_{Spec S, x}`. -/
noncomputable def specGerm (x : Spec S) : S →+* (Spec S).presheaf.stalk x :=
  ((Spec S).presheaf.germ ⊤ x (Opens.mem_top x)).hom.comp (Scheme.ΓSpecIso S).inv.hom

theorem specGerm_apply (x : Spec S) (s : S) :
    specGerm x s = (Spec S).presheaf.germ ⊤ x (Opens.mem_top x) ((Scheme.ΓSpecIso S).inv s) :=
  rfl

/-- The germ of `s` at `x` is a unit iff `x` lies in the basic open of `s` (Mathlib's
`mem_basicOpen_top`; `basicOpen_eq_of_affine` identifies it with `PrimeSpectrum.basicOpen s`). -/
theorem isUnit_specGerm_iff (x : Spec S) (s : S) :
    IsUnit (specGerm x s) ↔ x ∈ (Spec S).basicOpen ((Scheme.ΓSpecIso S).inv s) :=
  (Scheme.mem_basicOpen_top (Spec S) ((Scheme.ΓSpecIso S).inv s) x).symm

/-- A nonzerodivisor of `Γ(Spec S, ⊤)` has a nonzerodivisor germ at every point: the stalk is a
localization of the global sections (Mathlib's `isLocalization_stalk`). -/
theorem specGerm_mem_nonZeroDivisors (x : Spec S) {s : S}
    (hs : (Scheme.ΓSpecIso S).inv.hom s ∈ nonZeroDivisors Γ(Spec S, ⊤)) :
    specGerm x s ∈ nonZeroDivisors ((Spec S).presheaf.stalk x) := by
  have hloc := (isAffineOpen_top (Spec S)).isLocalization_stalk ⟨x, Opens.mem_top x⟩
  have hle := @IsLocalization.map_nonZeroDivisors_le Γ(Spec S, ⊤) _
    ((isAffineOpen_top (Spec S)).primeIdealOf ⟨x, Opens.mem_top x⟩).asIdeal.primeCompl
    ((Spec S).presheaf.stalk x) _
    (TopCat.Presheaf.algebra_section_stalk (Spec S).presheaf ⟨x, Opens.mem_top x⟩) hloc
  exact hle ⟨_, hs, rfl⟩

/-- `(Spec.map φ)♯` on global sections, applied to `ΓSpecIso.inv r`, is `ΓSpecIso.inv (φ r)`. -/
theorem appTop_Spec_map_apply {R : CommRingCat.{u}} (φ : R ⟶ S) (r : R) :
    (Spec.map φ).appTop ((Scheme.ΓSpecIso R).inv r) = (Scheme.ΓSpecIso S).inv (φ r) := by
  rw [Scheme.IdealSheafData.appTop_Spec_map φ, CommRingCat.comp_apply, CommRingCat.comp_apply,
      Iso.inv_hom_id_apply]

/-- The stalk map of `Spec.map φ` at `x` sends the germ of `r` to the germ of `φ r`. -/
theorem stalkMap_Spec_map_specGerm {R : CommRingCat.{u}} (φ : R ⟶ S) (x : Spec S) (r : R) :
    (Spec.map φ).stalkMap x (specGerm (Spec.map φ x) r) = specGerm x (φ r) := by
  rw [specGerm_apply, Scheme.Hom.germ_stalkMap_apply]
  change (Spec S).presheaf.germ ⊤ x (Opens.mem_top x) ((Spec.map φ).appTop _) = _
  rw [appTop_Spec_map_apply]
  rfl

end Spec

section Chart

variable {R : Type u} [CommRing R] (I : Ideal R) (b : I)

/-- `a = b · (a/b)` in `R[I/b]`, for `a, b ∈ I`. -/
theorem algebraMap_eq_mul_ratio (a : I) :
    algebraMap R (affineBlowUpAlgebra I b) a =
      algebraMap R (affineBlowUpAlgebra I b) b * affineBlowUpAlgebra.ratio I b a := by
  apply Subtype.ext
  have h1 : awayFrac (b : R) 1 b = 1 := by
    rw [awayFrac_one]
    exact Localization.mk_self (a := ⟨(b : R), Submonoid.mem_powers _⟩)
  have h2 := awayFrac_mul (a := (b : R)) 1 0 b a
  rw [add_zero, h1, one_mul] at h2
  change algebraMap R (Localization.Away (b : R)) a =
    algebraMap R (Localization.Away (b : R)) b * awayFrac (b : R) 1 a
  rw [← awayFrac_zero, ← awayFrac_zero, awayFrac_mul, zero_add, h2]

/-- At a point `x'` of the chart of `b`, the stalk of the exceptional ideal (pulled back to the
chart) is generated by the germ of `b`. -/
theorem stalkIdeal_comap_exceptionalIdeal_chart (x' : Spec (.of (affineBlowUpAlgebra I b))) :
    ((affineBlowUp.exceptionalIdeal I).comap (affineBlowUp.chart I b)).stalkIdeal x' =
      Ideal.span {specGerm x' (algebraMap R (affineBlowUpAlgebra I b) b)} := by
  rw [affineBlowUp.comap_exceptionalIdeal_chart, stalkIdeal_ofIdealTop, Ideal.map_span,
    Ideal.map_span, Set.image_singleton, Set.image_singleton]
  rfl

/-- The image of `r ∈ R` in `𝒪_{B, chart b x'}`, transported to the chart's stalk by the
isomorphism `(chart b).stalkMap x'`, is the germ of `r ∈ R[I/b]` (from `chart ≫ π = Spec (R →
R[I/b])`, `affineBlowUp.chart_π`). -/
theorem stalkMap_chart_stalkMap_π (x' : Spec (.of (affineBlowUpAlgebra I b))) (r : R) :
    (affineBlowUp.chart I b).stalkMap x'
        ((affineBlowUp.π I).stalkMap (affineBlowUp.chart I b x')
          ((Spec (.of R)).presheaf.germ ⊤ (affineBlowUp.π I (affineBlowUp.chart I b x'))
            (Opens.mem_top _) ((Scheme.ΓSpecIso (.of R)).inv.hom r))) =
      specGerm x' (algebraMap R (affineBlowUpAlgebra I b) r) := by
  have key : ∀ f : Spec (.of (affineBlowUpAlgebra I b)) ⟶ Spec (.of R),
      f = Spec.map (CommRingCat.ofHom (algebraMap R (affineBlowUpAlgebra I b))) →
      f.stalkMap x' ((Spec (.of R)).presheaf.germ ⊤ (f x') (Opens.mem_top _)
        ((Scheme.ΓSpecIso (.of R)).inv.hom r)) =
      specGerm x' (algebraMap R (affineBlowUpAlgebra I b) r) := by
    rintro f rfl
    exact stalkMap_Spec_map_specGerm (CommRingCat.ofHom (algebraMap R (affineBlowUpAlgebra I b)))
      x' r
  have h := key _ (affineBlowUp.chart_π I b)
  have h2 := congrArg (fun φ : (Spec (.of R)).presheaf.stalk
        ((affineBlowUp.chart I b ≫ affineBlowUp.π I) x') ⟶
        (Spec (.of (affineBlowUpAlgebra I b))).presheaf.stalk x' =>
      φ ((Spec (.of R)).presheaf.germ ⊤ ((affineBlowUp.chart I b ≫ affineBlowUp.π I) x')
        (Opens.mem_top _) ((Scheme.ΓSpecIso (.of R)).inv.hom r)))
    (Scheme.Hom.stalkMap_comp (affineBlowUp.chart I b) (affineBlowUp.π I) x')
  exact h2.symm.trans h


/-- At a point `x'` of the chart of `b`, the stalk of the exceptional ideal, read in the stalk of
`Spec R[I/b]` through the chart's stalk map (an isomorphism), is generated by the germ of `b` —
`stalkIdeal_comap_exceptionalIdeal_chart` in `map` form. -/
theorem stalkIdeal_exceptionalIdeal_chart_map (x' : Spec (.of (affineBlowUpAlgebra I b))) :
    ((affineBlowUp.exceptionalIdeal I).stalkIdeal (affineBlowUp.chart I b x')).map
        ((affineBlowUp.chart I b).stalkMap x').hom =
      Ideal.span {specGerm x' (algebraMap R (affineBlowUpAlgebra I b) b)} := by
  have h := (affineBlowUp.exceptionalIdeal I).stalkIdeal_comap (affineBlowUp.chart I b) x'
  rw [stalkIdeal_comap_exceptionalIdeal_chart] at h
  exact h.symm

/-- The stalk of the affine blow-up at a point `x'` of the chart of `b` is the localization
`R[I/b]_{x'}`, compatibly with germs (Mathlib's `Spec.stalkIso` through the chart's stalk map, an
isomorphism): the local blow-up of [Hau14, Definitions 4.15 and 4.16]. -/
theorem exists_ringEquiv_stalk_chart (x' : Spec (.of (affineBlowUpAlgebra I b))) :
    ∃ e : (affineBlowUp I).presheaf.stalk (affineBlowUp.chart I b x') ≃+*
        Localization.AtPrime (PrimeSpectrum.asIdeal x') (hp := PrimeSpectrum.isPrime x'),
      ∀ c : affineBlowUpAlgebra I b,
        (affineBlowUp.chart I b).stalkMap x' (e.symm (algebraMap _ _ c)) = specGerm x' c := by
  let e : (affineBlowUp I).presheaf.stalk (affineBlowUp.chart I b x') ≅
      .of (Localization.AtPrime (PrimeSpectrum.asIdeal x') (hp := PrimeSpectrum.isPrime x')) :=
    asIso ((affineBlowUp.chart I b).stalkMap x') ≪≫ Spec.stalkIso (.of (affineBlowUpAlgebra I b)) x'
  refine ⟨e.commRingCatIsoToRingEquiv, fun c => ?_⟩
  have h1 : e.commRingCatIsoToRingEquiv.symm (algebraMap _ _ c) = e.inv (algebraMap _ _ c) := rfl
  rw [h1]
  change ((asIso ((affineBlowUp.chart I b).stalkMap x') ≪≫
    Spec.stalkIso (.of (affineBlowUpAlgebra I b)) x').inv ≫ (affineBlowUp.chart I b).stalkMap x')
      (algebraMap _ _ c) = _
  rw [Iso.trans_inv, Category.assoc, asIso_inv, IsIso.inv_hom_id, Category.comp_id]
  have h := Spec.algebraMap_stalkIso_inv (R := CommRingCat.of (affineBlowUpAlgebra I b)) x'
  exact congrArg (fun φ : CommRingCat.of (affineBlowUpAlgebra I b) ⟶
    (Spec (CommRingCat.of (affineBlowUpAlgebra I b))).presheaf.stalk x' => φ c) h

/-- The stalk of the exceptional ideal at `chart b x'` is generated by the image of `a ∈ R` iff,
in the chart's stalk, the germs of `b` and of `a` generate the same ideal. -/
theorem stalkIdeal_exceptionalIdeal_chart_eq_span_iff (x' : Spec (.of (affineBlowUpAlgebra I b)))
    (a : I) :
    (affineBlowUp.exceptionalIdeal I).stalkIdeal (affineBlowUp.chart I b x') =
        Ideal.span
          {(affineBlowUp.π I).stalkMap (affineBlowUp.chart I b x')
            ((Spec (.of R)).presheaf.germ ⊤ (affineBlowUp.π I (affineBlowUp.chart I b x'))
              (Opens.mem_top _) ((Scheme.ΓSpecIso (.of R)).inv.hom a))} ↔
      Ideal.span {specGerm x' (algebraMap R (affineBlowUpAlgebra I b) b)} =
        Ideal.span {specGerm x' (algebraMap R (affineBlowUpAlgebra I b) a)} := by
  set j := affineBlowUp.chart I b
  set σ : (affineBlowUp I).presheaf.stalk (j x') ≃+*
      (Spec (.of (affineBlowUpAlgebra I b))).presheaf.stalk x' :=
    (asIso (j.stalkMap x')).commRingCatIsoToRingEquiv with hσ_def
  have hσ : (j.stalkMap x').hom = (σ : (affineBlowUp I).presheaf.stalk (j x') →+*
      (Spec (.of (affineBlowUpAlgebra I b))).presheaf.stalk x') := rfl
  have hinj : Function.Injective (Ideal.map (σ : (affineBlowUp I).presheaf.stalk (j x') →+*
      (Spec (.of (affineBlowUpAlgebra I b))).presheaf.stalk x')) := by
    intro A B h
    rw [Ideal.map_comap_of_equiv, Ideal.map_comap_of_equiv] at h
    exact Ideal.comap_injective_of_surjective _ σ.symm.surjective h
  rw [← hinj.eq_iff, ← hσ, ← Scheme.IdealSheafData.stalkIdeal_comap,
      stalkIdeal_comap_exceptionalIdeal_chart,
    Ideal.map_span, Set.image_singleton, stalkMap_chart_stalkMap_π]

/-- Inside the chart of `b`, the chart of `a` is the basic open of the global section `a/b` of
`Spec R[I/b]` (`affineBlowUp.chart_preimage_chart` in the scheme's vocabulary). -/
theorem chart_preimage_chart_eq_basicOpen (a : I) :
    affineBlowUp.chart I b ⁻¹ᵁ (affineBlowUp.chart I a).opensRange =
      (Spec (.of (affineBlowUpAlgebra I b))).basicOpen
        ((Scheme.ΓSpecIso (.of (affineBlowUpAlgebra I b))).inv (affineBlowUpAlgebra.ratio I b a)) :=
  (affineBlowUp.chart_preimage_chart I b a).trans
    (basicOpen_eq_of_affine (R := .of (affineBlowUpAlgebra I b))
      (affineBlowUpAlgebra.ratio I b a)).symm

/-- **The chart membership criterion** [Sta, Tag 0BFL]: a point `x` of the affine blow-up lies in
the chart of `a ∈ I` iff the image of `a` in `𝒪_{B,x}` generates the stalk of the exceptional
ideal at `x`. Proved from the chart overlaps and cancellation rather than from the universal
property. -/
theorem affineBlowUp.mem_chart_iff (a : I) (x : affineBlowUp I) :
    x ∈ (affineBlowUp.chart I a).opensRange ↔
      (affineBlowUp.exceptionalIdeal I).stalkIdeal x =
        Ideal.span
          {(affineBlowUp.π I).stalkMap x ((Spec (.of R)).presheaf.germ ⊤
            (affineBlowUp.π I x) (Opens.mem_top _) ((Scheme.ΓSpecIso (.of R)).inv.hom a))} := by
  obtain ⟨b, hb⟩ := affineBlowUp.exists_mem_opensRange_chart I x
  obtain ⟨x', rfl⟩ := Scheme.Hom.mem_opensRange.mp hb
  rw [stalkIdeal_exceptionalIdeal_chart_eq_span_iff, ← Scheme.Hom.mem_preimage,
    chart_preimage_chart_eq_basicOpen, ← isUnit_specGerm_iff]
  have hmul : specGerm x' (algebraMap R (affineBlowUpAlgebra I b) a) =
      specGerm x' (algebraMap R (affineBlowUpAlgebra I b) b) *
        specGerm x' (affineBlowUpAlgebra.ratio I b a) := by
    rw [algebraMap_eq_mul_ratio, map_mul]
  have hnz : specGerm x' (algebraMap R (affineBlowUpAlgebra I b) b) ∈
      nonZeroDivisors ((Spec (.of (affineBlowUpAlgebra I b))).presheaf.stalk x') :=
    specGerm_mem_nonZeroDivisors x' (affineBlowUp.chartGenerator_mem_nonZeroDivisors I b)
  constructor
  · intro hu
    rw [hmul, Ideal.span_singleton_mul_right_unit hu]
  · intro h
    exact isUnit_of_span_mul_eq_span hnz (by rw [← hmul]; exact h.symm)

/-- The relative form of the criterion: at a point `x` of the chart of `b`, the image of `a` is
the image of `b` times a factor `u` (the transport of `a/b ∈ R[I/b]` to `𝒪_{B,x}`), and `x` lies
in the chart of `a` as soon as `u` is a unit. -/
theorem affineBlowUp.exists_factor_of_mem_chart (a : I) (x : affineBlowUp I)
    (hxb : x ∈ (affineBlowUp.chart I b).opensRange) :
    ∃ u : (affineBlowUp I).presheaf.stalk x,
      (affineBlowUp.π I).stalkMap x ((Spec (.of R)).presheaf.germ ⊤ (affineBlowUp.π I x)
          (Opens.mem_top _) ((Scheme.ΓSpecIso (.of R)).inv.hom a)) =
        (affineBlowUp.π I).stalkMap x ((Spec (.of R)).presheaf.germ ⊤ (affineBlowUp.π I x)
          (Opens.mem_top _) ((Scheme.ΓSpecIso (.of R)).inv.hom b)) * u ∧
      (IsUnit u → x ∈ (affineBlowUp.chart I a).opensRange) := by
  obtain ⟨x', rfl⟩ := Scheme.Hom.mem_opensRange.mp hxb
  set j := affineBlowUp.chart I b
  set σ : (affineBlowUp I).presheaf.stalk (j x') ≃+*
      (Spec (.of (affineBlowUpAlgebra I b))).presheaf.stalk x' :=
    (asIso (j.stalkMap x')).commRingCatIsoToRingEquiv with hσ_def
  refine ⟨σ.symm (specGerm x' (affineBlowUpAlgebra.ratio I b a)), ?_, ?_⟩
  · apply σ.injective
    rw [map_mul, RingEquiv.apply_symm_apply]
    change (j.stalkMap x') _ = (j.stalkMap x') _ * _
    rw [stalkMap_chart_stalkMap_π, stalkMap_chart_stalkMap_π, ← map_mul, ← algebraMap_eq_mul_ratio]
  · intro hu
    rw [← Scheme.Hom.mem_preimage, chart_preimage_chart_eq_basicOpen, ← isUnit_specGerm_iff]
    have := hu.map σ
    rwa [RingEquiv.apply_symm_apply] at this

end Chart

end AlgebraicGeometry
